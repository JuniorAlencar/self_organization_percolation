# ==============================================================================
# ESTILO VISUAL PADRÃO - PERCOLATION & SELF-ORGANIZATION (PADRÃO ARTIGO / MAIN.PDF)
# ==============================================================================

# ---- Cores e Ciclo de Propriedades (Wong / Nature Color Universal Design) ----
# 0072B2: Azul (Site) | D55E00: Laranja avermelhado (Bond) | 009E73: Verde azulado
axes.prop_cycle : cycler('color', ['0072B2', 'D55E00', '009E73', 'F0E442', '56B4E9', 'E69F00', 'CC79A7', '000000'])

# ---- Dimensões de Figura e Exportação ----
figure.figsize : 14, 11
figure.autolayout : False
savefig.dpi : 300
savefig.bbox : tight
savefig.pad_inches : 0.05

# ---- Moldura / Spines (Open box: sem bordas superior e direita) ----
axes.spines.top : False
axes.spines.right : False
axes.spines.bottom : True
axes.spines.left : True
axes.linewidth : 1.2

# ---- Ticks do Eixo X (Graduações voltadas para fora, sem topo) ----
xtick.direction : out
xtick.top : False
xtick.bottom : True
xtick.major.size : 6.0
xtick.major.width : 1.2
xtick.major.pad : 6
xtick.minor.visible : False
xtick.minor.size : 3.5
xtick.minor.width : 0.9

# ---- Ticks do Eixo Y (Graduações voltadas para fora, sem direita) ----
ytick.direction : out
ytick.right : False
ytick.left : True
ytick.major.size : 6.0
ytick.major.width : 1.2
ytick.major.pad : 6
ytick.minor.visible : False
ytick.minor.size : 3.5
ytick.minor.width : 0.9

# ---- Linhas e Marcadores (Contorno preto nítido nos marcadores) ----
lines.linewidth : 1.8
lines.markersize : 7.0
lines.markeredgewidth : 1.0
lines.markeredgecolor : black
lines.solid_capstyle : round

# ---- Tipografia e Tamanho de Fontes ----
text.usetex : False
font.family : serif
mathtext.fontset : cm
font.size : 18
axes.titlesize : 18
axes.titlelocation : left
axes.titleweight : normal
axes.labelsize : 20
xtick.labelsize : 16
ytick.labelsize : 16

# ---- Legenda (Sem caixa/frame, espaçamento limpo) ----
legend.frameon : False
legend.fontsize : 15
legend.title_fontsize : 16
legend.handlelength : 1.5
legend.handletextpad : 0.5
legend.labelspacing : 0.4
legend.borderpad : 0.3
legend.borderaxespad : 0.4
legend.columnspacing : 1.0
legend.numpoints : 1
legend.scatterpoints : 1
